APP_KEY=
APP_ENV=local
APP_DEBUG=true
APP_URL=https://benchkit.dev.test

############################################
# Development Domains
#
# Read by Docker Compose (not the app) to build the Traefik router rules and
# network aliases in docker-compose.dev.yml. Each needs a 127.0.0.1 entry in
# your hosts file, and the bundled dev certificate only covers *.dev.test.
############################################
# APP_DOMAIN=benchkit.dev.test
# VITE_DOMAIN=vite.dev.test
# MAILPIT_DOMAIN=mailpit.dev.test

BOOST_PHP_EXECUTABLE_PATH="./vendor/bin/spin-mcp-wait.sh ./vendor/bin/spin run -T php php"
BOOST_COMPOSER_EXECUTABLE_PATH="./vendor/bin/spin run php composer"
BOOST_NPM_EXECUTABLE_PATH="./vendor/bin/spin run node npm"

OCTANE_SERVER=frankenphp

############################################
# Base Image Configuration (choose an image from https://hub.docker.com/r/serversideup/php)
############################################
# BASE_OS=trixie
# PHP_VERSION=8.5
# PHP_VARIATION=fpm-nginx