{
    "$schema": "./vendor/phpbench/phpbench/phpbench.schema.json",
    "runner.bootstrap": "phpbench-bootstrap.php",
    "runner.path": "app/Benchmarks/Php",
    "runner.progress": "verbose",
    "runner.retry_threshold": 3,
    "report.generators": {
        "benchmark_summary": {
            "extends": "aggregate",
            "title": "Benchkit Performance Summary",
            "description": "Aggregate benchmark results for Laravel operations",
            "cols": [
                "benchmark",
                "subject",
                "set",
                "revs",
                "iter",
                "mem_peak",
                "time_rev",
                "comp_z_value",
                "comp_deviation"
            ]
        },
        "comparison": {
            "extends": "aggregate",
            "title": "Performance Comparison",
            "description": "Side-by-side comparison of different approaches",
            "cols": [
                "benchmark",
                "subject", 
                "revs",
                "its",
                "mem_peak",
                "best",
                "mean",
                "mode",
                "worst",
                "stdev",
                "rstdev"
            ]
        }
    }
}