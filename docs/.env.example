# Core Nuxt Framework Settings
# The path the site is served under in production (Cloudflare Pages routes
# serversideup.net/open-source/benchkit → this static site). Leave as "/" for
# local dev at the root if you prefer.
NUXT_APP_BASE_URL=/open-source/benchkit

# Server Host settings (listen on all interfaces)
# HOST=0.0.0.0

# Nuxt SEO Settings (drive canonical URLs, sitemap, OG images).
# NUXT_SITE_URL is the ORIGIN only — the sub-path comes from NUXT_APP_BASE_URL.
NUXT_SITE_URL=https://localhost:3000
NUXT_SITE_NAME="BenchKit — Understand true Laravel performance"
NUXT_SITE_ENV="development"

# Analytics — off by default. Set to "true" to enable Plausible in production.
PLAUSIBLE_ENABLED=false
